/*
 * Header: S+C mark (optional) + menu icon, fixed.
 * Sizes are the Figma's at 1920: the mark SVG is used at its native size (1 unit = 1px, 20px built-in padding);
 * the menu bars are as wide as the S (30) and as thick as the plus stroke (6.24).
 * Its colour follows the section underneath (JS sets data-surface on <html>-level header).
 */
.site-header { position: fixed; inset: var(--wp-admin--admin-bar--height, 0px) 0 auto 0; z-index: 50; color: var(--color-white); pointer-events: none; transition: color .3s; }
.site-header > * { pointer-events: auto; }
.site-header[data-over="light"] { color: var(--color-black); }

.site-header .logo { position: absolute; left: 0; top: 0; }

.menu-btn {
  position: absolute; right: calc(var(--gutter) - 8 * var(--u)); top: calc(22.5 * var(--u) - 8 * var(--u));
  padding: calc(8 * var(--u)); background: none; border: 0; color: inherit; cursor: pointer;
}
.burger { position: relative; display: block; width: calc(30 * var(--u)); height: calc(33.24 * var(--u)); }
.burger i { position: absolute; left: 0; width: 100%; height: calc(6.24 * var(--u)); background: currentColor; transition: transform .35s cubic-bezier(.65, 0, .35, 1); }
.burger i:nth-child(1) { top: 0; }
.burger i:nth-child(2) { top: calc(13.5 * var(--u)); }
.burger i:nth-child(3) { top: calc(27 * var(--u)); }
/* collapsed: the lower bars slide up into the top bar */
.burger.is-collapsed i:nth-child(2) { transform: translateY(calc(-13.5 * var(--u))); }
.burger.is-collapsed i:nth-child(3) { transform: translateY(calc(-27 * var(--u))); }

@media (max-width: 820px) {
  .menu-btn { top: 12px; right: 8px; padding: 8px; }
}
