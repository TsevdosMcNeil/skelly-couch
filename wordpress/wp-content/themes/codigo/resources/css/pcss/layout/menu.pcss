/*
 * Menu bar (Figma: OpenMenu): wipes down from the top over everything; content stays in place and is
 * revealed by the moving edge. Inside: white wordmark, links, the menu icon collapsing into one bar, search.
 */
.nav-bar {
  position: fixed; inset: var(--wp-admin--admin-bar--height, 0px) 0 auto 0; z-index: 100; padding: calc(20 * var(--u)) var(--gutter);
  background: var(--color-blue); color: var(--color-white);
  clip-path: inset(0 0 100% 0); pointer-events: none; transition: clip-path .45s cubic-bezier(.65, 0, .35, 1);
}
.nav-open .nav-bar { clip-path: inset(0 0 0 0); pointer-events: auto; }
.nav-bar .logo { position: relative; width: max-content; }
.nav-bar ul {
  list-style: none; display: flex; justify-content: space-between; position: absolute;
  left: calc(var(--col) * 2); width: calc(780 * var(--u)); top: calc(20 * var(--u));
  font-size: var(--text-body); line-height: var(--lh-body);
}
.nav-open .nav-bar .burger i { transition-delay: .1s; }
.nav-search {
  position: absolute; right: var(--gutter); top: calc(60 * var(--u)); width: calc(40 * var(--u)); height: calc(40 * var(--u));
  padding: 0; color: inherit; background: none; border: 0; cursor: pointer;
}
.nav-search svg { display: block; width: 100%; height: 100%; }

@media (max-width: 820px) {
  .nav-bar { padding: 90px var(--gutter) 30px; }
  .nav-bar .logo { position: absolute; left: var(--gutter); top: calc(20 * var(--u)); }
  .nav-bar ul { position: static; flex-direction: column; gap: 16px; width: auto; font-size: 22px; }
  .nav-search { top: auto; bottom: 30px; }
}
