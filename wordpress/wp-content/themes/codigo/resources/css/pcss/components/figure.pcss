/*
 * Image block with an aperture or comments: its <img> is wrapped in .figure__media (app/blocks.php),
 * the positioning box for the extra layers.
 */
.figure__media { position: relative; overflow: clip; }
.wp-block-image.is-resized .figure__media { width: fit-content; max-width: 100%; }
.figure__media > .figure__img { display: block; }

/*
 * Comments darken the picture: magnifying-glass comments while the image is hovered, growing comments while a
 * note is open. --darken = the Image block's "Darken the image" (0–1, set in app/blocks.php), 18% by default.
 * The "+"s, zoomed squares and notes sit above the dark layer.
 */
.figure__media::after {
  content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none;
  background: rgb(0 0 0 / var(--darken, .18)); opacity: 0; transition: opacity var(--t-hover) var(--ease-hover);
}
.figure__media:has(.comment--grow.is-open)::after,
.figure__media:has(.comment--magnify):hover::after,
.figure__media:has(.comment--magnify.is-open)::after { opacity: 1; }
