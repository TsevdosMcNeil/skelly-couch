/*
 * Project hero (Figma: Project Page — Type A, top).
 * Blue band 260 tall: S+C mark top-left (scrolls away with the page, the menu icon stays fixed),
 * project name + subtitle in Large Body at the second half (970). Then the hero image, full width.
 */
.project-hero__band { position: relative; height: calc(260 * var(--u)); }
.project-hero__mark { position: absolute; left: 0; top: 0; }
.project-hero__titles { position: absolute; left: var(--half); top: calc(20 * var(--u)); max-width: calc(770 * var(--u)); }
.project-hero__title { font: inherit; }
.project-hero__subtitle { color: var(--sc-blue-soft); }
.project-hero__image { width: 100%; height: auto; }

@media (max-width: 820px) {
  .project-hero__band { height: auto; padding: 96px var(--gutter) 30px; }
  .project-hero__titles { position: static; }
}
.project-hero .block-placeholder { height: calc(600 * var(--u)); }
